{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": { "~/*": ["./renderer/src/*"] },
    "noEmit": true
  },
  "include": ["renderer/src/**/*.ts", "renderer/src/**/*.vue", "shared/**/*.ts"]
}
